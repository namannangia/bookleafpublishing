# Copy to .env (git-ignored). Everything is optional for local development.

# Claude API key. Without it the app runs in "manual mode": rule-based triage, no AI drafts.
ANTHROPIC_API_KEY=

# Models (defaults shown). Drafts can be upgraded independently, e.g. claude-sonnet-5-5.
AI_CLASSIFY_MODEL=claude-haiku-5-5
AI_DRAFT_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Postgres connection string. Leave empty to use an embedded Postgres (PGlite) stored in .data/
DATABASE_URL=
PG_POOL_MAX=10

# Required in production (min 16 chars).
JWT_SECRET=dev-only-secret-change-me-in-prod

PORT=4000
SEED_ON_BOOT=true
