# Copy to .env (git-ignored). Everything is optional for local development.

# AI provider. Without a key the app runs in "manual mode": rule-based triage, no AI drafts.
# AI_PROVIDER defaults to whichever key is set (deepseek first). Options: deepseek | anthropic | none
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Models. DeepSeek: deepseek-flash (default) or deepseek-v4-pro. Claude: claude-haiku-5-5.
AI_CLASSIFY_MODEL=deepseek-flash
AI_DRAFT_MODEL=deepseek-flash
# Reasoning effort: none (thinking off) | low | medium | high
AI_CLASSIFY_EFFORT=none
AI_DRAFT_EFFORT=low
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Postgres connection string. Leave empty to use an embedded Postgres (PGlite) stored in .data/
DATABASE_URL=
PG_POOL_MAX=10

# Required in production (min 16 chars).
JWT_SECRET=dev-only-secret-change-me-in-prod

PORT=4000
SEED_ON_BOOT=true
